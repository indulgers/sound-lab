# 本地开发用支付宝配置示例。复制为 .dev.vars 后填入真实值，
# 或运行 npm run sync-dev-vars 从 .alipay-sandbox.json 自动生成。
# 生产环境不要用这个文件，用 wrangler secret put 设置。
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_PKCS1=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 可选：异步通知地址（本地开发一般留空）
# ALIPAY_NOTIFY_URL=
# 可选：卖家校验（沙箱配置里有 pid 时 sync-dev-vars 会自动填）
# ALIPAY_SELLER_ID=
# ALIPAY_SELLER_EMAIL=
