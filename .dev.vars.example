# 本地开发用支付宝配置示例。复制为 .dev.vars 后填入真实值，
# 或运行 npm run sync-dev-vars 从 .alipay-sandbox.json 自动生成。
# 生产环境不要用这个文件，用 wrangler secret put 设置。
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_PKCS1=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 可选：异步通知地址（本地开发一般留空）
# ALIPAY_NOTIFY_URL=
# 可选：卖家校验（沙箱配置里有 pid 时 sync-dev-vars 会自动填）
# ALIPAY_SELLER_ID=
# ALIPAY_SELLER_EMAIL=

# 海外版 Waffo Pancake（test 环境）。私钥填单行 raw base64
# （去掉 PEM 头尾行和换行）；SDK 也接受 PEM 或字面 \n。
# 产品 ID 是公开标识，不是密钥；生产切换前不要 publish 产品，
# 也不要把 WAFFO_ENV 改成 prod。
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENV=test
WAFFO_PRODUCT_FOCUS_PACK=
WAFFO_PRODUCT_SLEEP_PACK=
WAFFO_PRODUCT_RAIN_NIGHT_PACK=


# QA Plus 测试账号：必须是登录后 /api/auth/me 返回的随机 userId，
# 不要填写邮箱。失效或超出未来 30 天会自动关闭。
# 本地 localhost 默认允许；线上 Worker 还需显式设置 QA_ALLOWED_HOSTS。
# 不配置这两个变量时，所有用户正常按真实订阅判断。
# SOUNDLAB_QA_PLUS_USER_IDS=
# SOUNDLAB_QA_PLUS_EXPIRES_AT=2026-11-25T12:00:00Z
# SOUNDLAB_QA_PLUS_ALLOWED_HOSTS=staging.example.workers.dev
